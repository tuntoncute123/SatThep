PORT=3000
DATA_DIR=./data
# Vercel requires a hosted database. Leave both empty to use local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_EMAIL=admin@thepviet.vn
ADMIN_PASSWORD=replace-with-a-strong-password
# Set to 1 when serving through HTTPS (automatic on Vercel):
COOKIE_SECURE=0
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
# Otherwise login/quote rate limits share a single application bucket.
TRUST_PROXY=0
